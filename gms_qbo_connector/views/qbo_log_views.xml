<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qbo_sync_log_list" model="ir.ui.view">
        <field name="name">qbo.sync.log.list</field>
        <field name="model">qbo.sync.log</field>
        <field name="arch" type="xml">
            <tree string="QBO Sync Log" decoration-danger="status == 'error'"
                  decoration-success="status == 'success'"
                  decoration-warning="status == 'partial'">
                <field name="create_date"/>
                <field name="config_id"/>
                <field name="operation"/>
                <field name="status"/>
                <field name="records_synced"/>
                <field name="message"/>
                <field name="odoo_record"/>
                <field name="qbo_id"/>
            </tree>
        </field>
    </record>

    <record id="view_qbo_sync_log_form" model="ir.ui.view">
        <field name="name">qbo.sync.log.form</field>
        <field name="model">qbo.sync.log</field>
        <field name="arch" type="xml">
            <form string="QBO Sync Log Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="config_id"/>
                            <field name="operation"/>
                            <field name="status"/>
                            <field name="records_synced"/>
                        </group>
                        <group>
                            <field name="odoo_record"/>
                            <field name="qbo_id"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="Detail" attrs="{'invisible': [('detail', '=', False)]}">
                        <field name="detail" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qbo_sync_log" model="ir.actions.act_window">
        <field name="name">QBO Sync Log</field>
        <field name="res_model">qbo.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
